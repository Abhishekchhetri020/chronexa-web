# Chronexa Web backend — environment template.
# Copy to .env on the VPS and edit. docker-compose reads .env automatically.

# Comma-separated list of allowed CORS origins. Leave blank to use the built-in
# default (https://abhishekchhetri020.github.io + localhost dev ports).
# CORS_ORIGINS=https://abhishekchhetri020.github.io,https://your-domain.tld

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Domain for Let's Encrypt — used by certbot in docker-compose.yml.
# Set this BEFORE running the certbot one-shot for the first cert.
DOMAIN=chronexa.example.com

# Email Let's Encrypt uses for expiry reminders.
ACME_EMAIL=abhishekchhetri020@gmail.com
